<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".AddCardActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout_add_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_add_card"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="스터디 그룹 만들기"
            app:navigationIcon="@drawable/ic_arrow_back" /> <!-- ic_arrow_back 드로어블 필요 -->

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appbar_layout_add_card"
        app:layout_constraintBottom_toTopOf="@+id/btn_create_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹 이름"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_card_title_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="스터디 그룹 이름을 입력해주세요"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textSize="16sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그룹 설명"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_card_subtitle_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="스터디 그룹에 대해 설명해주세요"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    android:gravity="top"
                    android:textSize="16sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최대 인원"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_edittext_background"
                android:padding="8dp"
                android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btn_decrease_members_page"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_remove_circle_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="인원 감소"/>

            <TextView
                android:id="@+id/tv_member_count_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>

            <ImageButton
                android:id="@+id/btn_increase_members_page"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add_circle_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="인원 증가"/>
        </LinearLayout>

        <!-- 스터디 카테고리 선택 -->
        <LinearLayout
            android:id="@+id/layout_category_select_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/selectable_item_background_rounded"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_category"
            app:tint="@color/gray_700"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="스터디 카테고리 선택"
            android:textColor="@android:color/black"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tv_selected_category_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선택"
            android:textColor="@color/medium_gray"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/medium_gray"/>
    </LinearLayout>

    <!-- 스터디 기간 설정 -->
    <LinearLayout
        android:id="@+id/layout_date_select_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/selectable_item_background_rounded"
        android:clickable="true"
        android:focusable="true">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_calendar"
        app:tint="@color/gray_700"
        android:layout_marginEnd="12dp"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="스터디 기간 설정"
        android:textColor="@android:color/black"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/tv_selected_date_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="선택"
        android:textColor="@color/medium_gray"
        android:textSize="16sp"
        android:layout_marginEnd="8dp"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chevron_right"
    app:tint="@color/medium_gray"/>
</LinearLayout>
    </LinearLayout>
    </ScrollView>

<Button
    android:id="@+id/btn_create_group"
    android:layout_width="0dp"
    android:layout_height="56dp"
    android:text="그룹 만들기"
    android:textSize="18sp"
    android:textColor="@android:color/white"
    android:backgroundTint="#143285"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="16dp"
    app:cornerRadius="8dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
