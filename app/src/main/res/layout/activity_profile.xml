<!-- activity_profile.xml -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ProfileActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 프로필 상단 정보 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <!-- 원형 프로필 이미지 (CardView 사용) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_profile_image_container"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="4dp"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"
                        android:contentDescription="프로필 이미지"
                        android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/card_profile_image_container"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="16dp"
                    tools:text="이름"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/tv_profile_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_profile_name"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="8dp"
                    tools:text="상태 메시지"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray"/>
            </RelativeLayout>

            <!-- 스터디 가능 시간 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tv_study_time_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스터디 가능 시간"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>
                    <TextView
                        android:id="@+id/tv_study_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_study_time_card_title"
                        android:layout_marginTop="4dp"
                        tools:text="시간 정보"
                        android:textSize="14sp"/>
                    <ImageButton
                        android:id="@+id/btn_edit_study_time"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:tint="#808080"
                        android:contentDescription="스터디 가능 시간 수정"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- 나의 스터디 카드 (예시) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="나의 스터디"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="8dp"/>

                    <!-- 서버에서 불러온 나의 스터디 목록이 추가될 레이아웃 -->
                    <LinearLayout
                        android:id="@+id/layout_my_study_groups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 설정 메뉴 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">
                    <RelativeLayout
                        android:id="@+id/btn_profile_notification_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/icon_notification_settings"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="#808080"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/icon_notification_settings"
                            android:layout_centerVertical="true"
                            android:text="알림 설정"
                            android:textSize="15sp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/btn_profile_edit_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/icon_edit_profile"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#808080"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/icon_edit_profile"
                            android:layout_centerVertical="true"
                            android:text="프로필 수정"
                            android:textSize="15sp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/btn_profile_study_env_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/icon_study_env_settings"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            app:tint="#808080"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/icon_study_env_settings"
                            android:layout_centerVertical="true"
                            android:text="스터디 환경 설정"
                            android:textSize="15sp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/btn_profile_account_management"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/icon_account_management"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_manage"
                            app:tint="#808080"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/icon_account_management"
                            android:layout_centerVertical="true"
                            android:text="계정 관리"
                            android:textSize="15sp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/btn_profile_blocked_accounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/icon_blocked_accounts"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#808080"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/icon_blocked_accounts"
                            android:layout_centerVertical="true"
                            android:text="차단된 계정"
                            android:textSize="15sp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/btn_profile_logout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/icon_logout"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_set_as"
                            app:tint="#FF0000"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/icon_logout"
                            android:layout_centerVertical="true"
                            android:text="로그아웃"
                            android:textColor="#FF0000"
                            android:textSize="15sp"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/bottom_navigation_menu" />
</RelativeLayout>
