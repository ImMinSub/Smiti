<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/rounded_white_background_dialog">

    <!-- 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="추천 시간"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- 추천 시간 내용을 표시할 ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp"
        android:background="#F8F9FA"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 섹션 1: 스터디 가능 시간대 정리 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="스터디 가능 시간대 정리"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#34495E"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E6ED"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_available_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="로딩 중..."
                    android:textSize="14sp"
                    android:textColor="#5A6C7D"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- 섹션 2: 가장 많은 그룹 사용자가 동시에 참여할 수 있는 스터디 추천 시간대 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="그룹 추천 시간대"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#34495E"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E6ED"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_group_recommended_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="로딩 중..."
                    android:textSize="14sp"
                    android:textColor="#5A6C7D"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- 섹션 3: 추천 시간대 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="추천 시간대"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#5A6C7D"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E6ED"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_final_recommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="로딩 중..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#5A6C7D"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 확인 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end">

        <android.widget.Button
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="확인"
            android:textSize="14sp"
            android:textColor="#5A6C7D"
            android:background="@drawable/button_background"
            android:paddingHorizontal="24dp"
            android:minWidth="80dp" />

    </LinearLayout>

</LinearLayout>
