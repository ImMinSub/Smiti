<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/card_background_selector"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_card_image"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/tv_card_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_card_image"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="스터디 그룹 제목" />

    <TextView
        android:id="@+id/tv_card_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_card_title"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="스터디 그룹에 대한 간단한 설명입니다. 이 설명은 두 줄까지 보일 수 있으며, 그 이상은 잘립니다." />

    <LinearLayout
        android:id="@+id/layout_category_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_card_subtitle"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_category_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_category"
            app:tint="@color/gray_700"
            android:contentDescription="카테고리 아이콘" />

        <TextView
            android:id="@+id/tv_card_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gray_700"
            tools:text="프로그래밍" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_date_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_category_info"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_calendar_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/gray_700"
            android:contentDescription="스터디 기간 아이콘" />

        <TextView
            android:id="@+id/tv_card_study_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gray_700"
            tools:text="2025-06-01" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_member_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_date_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_members_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_group_members"
            app:tint="@color/gray_700"
            android:contentDescription="인원 수 아이콘" />

        <TextView
            android:id="@+id/tv_card_member_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gray_700"
            tools:text="최대 5명" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_delete_item"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"
        tools:visibility="visible"
        android:elevation="4dp"
        android:contentDescription="삭제" />

</androidx.constraintlayout.widget.ConstraintLayout>
