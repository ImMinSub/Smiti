<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".GroupDetailActivity"> <!-- 또는 .GroupSearchResultActivity -->

    <!-- 상단 이미지 및 뒤로가기 버튼 영역 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout_group_detail"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_group_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:contentScrim="?attr/colorPrimary"
            app:statusBarScrim="?attr/colorPrimaryVariant"
            android:fitsSystemWindows="true">

            <ImageView
                android:id="@+id/iv_group_detail_header_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/image1"
                android:contentDescription="그룹 대표 이미지"
                app:layout_collapseMode="parallax"
                android:fitsSystemWindows="true"/>

            <!-- 반투명 어두운 오버레이 (텍스트 가독성 향상용, 선택 사항) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40000000"
                android:fitsSystemWindows="true"/>


            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_group_detail_fake"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                android:background="@android:color/transparent"/>
            <!-- 가짜 툴바는 CollapsingToolbarLayout이 제목 등을 표시할 공간으로 사용하며,
                 실제 뒤로가기 버튼은 아래 ImageButton으로 구현 -->

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 뒤로가기 버튼 (이미지 위에 표시) -->
    <ImageButton
        android:id="@+id/btn_group_detail_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_arrow_back_white"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@android:color/white"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:contentDescription="뒤로가기"
        app:layout_anchor="@id/app_bar_layout_group_detail"
        app:layout_anchorGravity="top|start" />
    <!-- 참고: status bar 높이에 따라 marginTop 조정 필요할 수 있음 -->


    <!-- 스크롤 가능한 콘텐츠 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:background="@drawable/bg_group_content_rounded_top"> <!-- 상단 모서리 둥글게 처리 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 프로필 아이콘 및 그룹 이름 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/iv_group_profile_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:contentDescription="그룹 프로필 아이콘"
                    android:layout_marginEnd="12dp"/>
                <!-- 원형으로 만들려면 CircleImageView 라이브러리 사용 또는 CardView로 감싸기 -->

                <TextView
                    android:id="@+id/tv_group_detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="제목 (그룹 이름)"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

            <!-- 그룹 설명 -->
            <TextView
                android:id="@+id/tv_group_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="토익 스터디입니다.\n벼락치기 환영\n디스코드로 진행합니다."
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="12dp"/>

            <!-- 점수 (선택 사항, 이미지에 명확히 없으면 숨김) -->
            <TextView
                android:id="@+id/tv_group_detail_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="AI 추천: 85점"
                android:textSize="14sp"
                android:textColor="@color/colorPrimaryDark"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/> <!-- 이미지에 없으므로 기본 숨김 -->

            <!-- 멤버 정보 (선택 사항) -->
            <TextView
                android:id="@+id/tv_member_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="참여 인원: 3 / 10명"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="24dp"
                android:visibility="gone"/> <!-- 필요시 visible -->

            <!-- 그룹 참가하기 버튼 -->
            <Button
                android:id="@+id/btn_group_detail_join"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="그룹 참가하기"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_join_button_rounded"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:backgroundTint="@null"/> <!-- background drawable 사용 시 backgroundTint는 null로 -->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
