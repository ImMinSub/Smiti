<!-- res/drawable/rounded_edittext_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" /> <!-- 내부 채우기 색상, 필요시 변경 -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" /> <!-- 테두리 색상, 필요시 변경 (@color/gray_400 등) -->
    <corners android:radius="8dp" /> <!-- 모서리 둥글기 -->
</shape>
