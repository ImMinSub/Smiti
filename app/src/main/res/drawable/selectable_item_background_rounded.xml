<!-- res/drawable/selectable_item_background_rounded.xml -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight"> <!-- 물결 효과 색상 -->

    <!-- 배경 모양 (마스크 역할도 겸함) -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" /> <!-- 실제 배경색이 아님, 마스크용 -->
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- 기본 상태 배경 (선택 사항, 위에 item android:id="@android:id/background" 로 추가 가능)
         만약 LinearLayout 자체에 android:background 속성으로 단색을 주고 싶지 않다면,
         이 drawable이 직접 배경색을 가지도록 할 수 있습니다.
         그렇지 않다면, 이 부분은 생략하고 ripple 효과만 적용되도록 할 수 있습니다.
         여기서는 ripple 효과를 위한 기본적인 마스크만 제공합니다.
         실제 배경색은 해당 뷰의 android:background 속성에서 별도로 지정하거나
         여기에 <item android:drawable="@drawable/rounded_white_background_for_selectable"/> 와 같이
         별도의 shape drawable을 참조할 수 있습니다.

         간단하게는 다음과 같이 content item을 추가할 수 있습니다.
    -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" /> <!-- 또는 원하는 기본 배경색 -->
            <corners android:radius="8dp" />
            <!-- 필요시 테두리 추가 -->
            <!-- <stroke android:width="1dp" android:color="#E0E0E0"/> -->
        </shape>
    </item>
</ripple>
