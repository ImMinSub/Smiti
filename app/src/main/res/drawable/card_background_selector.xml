<!-- res/drawable/card_background_selector.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 눌렸을 때 (pressed state) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E0" /> <!-- 눌렸을 때의 배경색 (예: 밝은 회색) -->
            <corners android:radius="8dp" />    <!-- 모서리 둥글기 -->
            <stroke android:width="1dp" android:color="#BDBDBD" /> <!-- 눌렸을 때의 테두리 (선택 사항) -->
        </shape>
    </item>

    <!-- 기본 상태 (default state) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" /> <!-- 기본 배경색 (예: 흰색) -->
            <corners android:radius="8dp" />       <!-- 모서리 둥글기 -->
            <stroke android:width="1dp" android:color="#E0E0E0" /> <!-- 기본 테두리 (예: 매우 밝은 회색) -->
        </shape>
    </item>

</selector>
